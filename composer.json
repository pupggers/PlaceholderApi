{
  "name": "pup/placeholderapi",
  "version": "3.2.0",
  "description": "A simple and efficient placeholder system for PocketMine-MP. Originally created for the Kyro core.",
  "type": "library",
  "keywords": ["pocketmine", "placeholder", "api", "virion", "pmmp", "plugin"],
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "pupggers"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/pupggers/PocketMine-MP"
    }
    ],
  "require": {
    "axolotl-pm/pocketmine-mp": "dev-stable"
  },
  "autoload": {
    "classmap": [
      "src"
    ]
  },
  "extra": {
    "virion": {
      "spec": "3.1",
      "namespace-root": "pup\\placeholderapi"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}